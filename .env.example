# Gemini API Key (Required for Script generation & Gemini models)
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=

# Fal.ai API Key (Recommended for Fast Text-to-Video, Kling, Minimax, Luma, Lipsync)
# Get from: https://fal.ai/
FAL_KEY=

# Replicate API Token (For Stable Video Diffusion, CogVideo, SadTalker)
# Get from: https://replicate.com/
REPLICATE_API_TOKEN=

# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=
